{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "removeComments": false,
    "showLineNumbers": false,
    "copyToClipboard": false,
    "topFilesLength": 15,
    "compress": false,
    "headerText": "ZER0 — whole-repository pack, generated by `bun run repomix`. Do not edit by hand; it is rebuilt from the working tree."
  },
  "include": [],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "repomix-output.xml",
      "src-tauri/src/catalog/catalog.json",
      "src/i18n/locales/*/translation.json",
      "src/content/release-notes/*.md",
      "docs/vendor/**",
      "bun.lock",
      "src-tauri/Cargo.lock",
      ".nix/bun.nix"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
