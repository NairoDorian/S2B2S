{
  "name": "handy-app",
  "private": true,
  "version": "0.9.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "vite:build": "vite build",
    "typecheck": "bun x tsc -b",
    "preview": "vite preview",
    "tauri": "bun scripts/tauri-runner.ts",
    "dev:fast": "bun scripts/tauri-runner.ts dev --fast",
    "dev:full": "bun scripts/tauri-runner.ts dev --full",
    "build:fast": "bun scripts/tauri-runner.ts build --local-gpu",
    "build:full": "bun scripts/tauri-runner.ts build --full",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "prettier --write . && cd src-tauri && cargo fmt",
    "format:check": "prettier --check . && cd src-tauri && cargo fmt -- --check",
    "format:frontend": "prettier --write .",
    "format:backend": "cd src-tauri && cargo fmt",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "check:translations": "bun scripts/check-translations.ts",
    "check:model-languages": "bun scripts/check-model-language-coverage.ts",
    "prune:target": "bun scripts/prune-target.ts",
    "update-deps": "bun scripts/update-deps.ts",
    "update:rtk": "bun scripts/update-rtk.ts",
    "postinstall": "bun scripts/check-nix-deps.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "~2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "2.3.3",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-fs": "2.5.2",
    "@tauri-apps/plugin-global-shortcut": "~2.3.2",
    "@tauri-apps/plugin-opener": "2.5.5",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-sql": "2.4.1",
    "@tauri-apps/plugin-store": "~2.4.4",
    "@tauri-apps/plugin-updater": "2.11.0",
    "i18next": "26.4.2",
    "immer": "11.1.18",
    "lucide-react": "1.44.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "17.0.13",
    "react-markdown": "^10.1.0",
    "react-select": "^5.10.2",
    "remark-gfm": "^4.0.1",
    "sonner": "2.0.8",
    "tailwindcss": "^4.3.3",
    "tauri-plugin-macos-permissions-api": "2.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0-alpha-2026-09-10",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "26.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-select": "^5.0.1",
    "@vitejs/plugin-react": "6.1.1",
    "eslint-plugin-i18next": "^6.1.5",
    "oxlint": "1.82.0",
    "prettier": "4.0.0-alpha.13",
    "typescript": "7.1.0-dev.20260910.1",
    "vite": "8.3.0"
  }
}
