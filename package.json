{
  "name": "s2b2s-app",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "prettier --write . && cd src-tauri && cargo fmt",
    "format:check": "prettier --check . && cd src-tauri && cargo fmt -- --check",
    "format:frontend": "prettier --write .",
    "format:backend": "cd src-tauri && cargo fmt",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "check:translations": "bun scripts/check-translations.ts",
    "sync:translations": "bun scripts/sync-translations.ts",
    "sync:repos": "powershell -ExecutionPolicy Bypass ./scripts/sync-all-repos.ps1",
    "compile:audiocpp": "powershell -ExecutionPolicy Bypass ./scripts/compile-audiocpp.ps1 -Backend cuda -Target audiocpp_server",
    "repomix": "repomix",
    "before-commit": "bun scripts/before-commit.ts",
    "validate": "bun scripts/before-commit.ts --full",
    "arch": "bun scripts/generate-arch.ts",
    "create-icons": "bun scripts/create-icons.ts",
    "update-deps": "bun scripts/update-deps.ts",
    "update:all": "bun scripts/update-deps.ts",
    "postinstall": "bun scripts/check-nix-deps.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "~2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "~2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-global-shortcut": "~2.3.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@types/three": "^0.185.4",
    "i18next": "^26.3.6",
    "immer": "^11.1.16",
    "lucide-react": "^1.31.0",
    "react": "19.3.0-canary-beef6d60-20260813",
    "react-dom": "19.3.0-canary-beef6d60-20260813",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "react-select": "^5.10.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tauri-plugin-macos-permissions-api": "2.3.0",
    "three": "^0.185.1",
    "zod": "4.5.0-canary.20260814T055530",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0-alpha-2026-08-14",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-select": "^5.0.1",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint-plugin-i18next": "^6.1.5",
    "oxlint": "^1.78.0",
    "prettier": "4.0.0-alpha.13",
    "repomix": "^1.18.0",
    "typescript": "7.1.0-dev.20260813.1",
    "vite": "^8.2.1"
  }
}
