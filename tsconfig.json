{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "bun"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* JSX. `preserve` hands untransformed JSX to Vite's Solid plugin.
       `jsxImportSource` is `@solidjs/web` for the whole tree (no file carries
       a pragma); `tsconfig.json` is a type-checking setting only (noEmit is
       true), and Vite picks the transform independently. */
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",

    /* Path Aliases */
    "paths": {
      "@/*": ["./src/*"],
      "@/bindings": ["./src/bindings.ts"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
